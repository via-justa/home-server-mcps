# Simple case: one instance per service. Set URL + API_KEY, or leave both unset
# to skip a service entirely (its tools return a clear "not configured" error).

SONARR_URL=http://sonarr.local:8989
SONARR_API_KEY=

RADARR_URL=http://radarr.local:7878
RADARR_API_KEY=

LIDARR_URL=http://lidarr.local:8686
LIDARR_API_KEY=

PROWLARR_URL=http://prowlarr.local:9696
PROWLARR_API_KEY=

SEERR_URL=http://seerr.local:5055
SEERR_API_KEY=

# Not wired up yet — see README "Known gaps". Set these once support lands.
# SHELFMARK_URL=http://shelfmark.local:8084
# SHELFMARK_API_KEY=
# PROFILARR_URL=http://profilarr.local:6868
# PROFILARR_API_KEY=

# Multi-instance case (e.g. separate 4K Radarr/Sonarr): set <SERVICE>_INSTANCES
# to a JSON array instead of the URL/API_KEY pair above. Exactly one entry
# should have "is_default": true (the first one is used if none do).
#
# RADARR_INSTANCES=[{"id":"hd","name":"Radarr HD","base_url":"http://radarr:7878","api_key":"...","is_default":true},{"id":"4k","name":"Radarr 4K","base_url":"http://radarr4k:7878","api_key":"..."}]

# HTTP transport
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Lowest-priority config source: a YAML file (see config.example.yaml), read
# only for services with no env vars set above. Defaults to ./config.yaml.
# MEDIA_APPS_MCP_CONFIG=/etc/media-apps-mcp/config.yaml

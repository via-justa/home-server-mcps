{
  "id": "echo",
  "name": "Echo (test fixture)",
  "version": "1.0.0",
  "sdk": "^0.1.0",
  "entry": "index.mjs",
  "binding": {
    "namespace": "echo",
    "functions": ["call"]
  },
  "connection": {
    "schema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "writeOnly": true
        }
      }
    },
    "ui": {
      "token": {
        "widget": "secret"
      }
    }
  },
  "capabilities": {
    "attestation": true,
    "targets": true
  },
  "sensitiveKeys": ["password"],
  "matchProfiles": {
    "name-prefix": [
      {
        "field": "/name",
        "label": "Name prefix",
        "op": "prefix",
        "widget": "prefix"
      }
    ]
  }
}
